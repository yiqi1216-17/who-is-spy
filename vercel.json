{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace packages/web",
  "outputDirectory": "packages/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE_WITH_YOUR_BACKEND.onrender.com/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/api/games/(.*)/stream",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-transform" }]
    }
  ]
}
